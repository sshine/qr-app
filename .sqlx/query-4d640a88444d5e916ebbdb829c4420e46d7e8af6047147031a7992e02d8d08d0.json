  "query": "\n            SELECT DISTINCT ON (binding_id) binding_id, id, taken_at,\n                   count(*) OVER (PARTITION BY binding_id) AS \"total!\"\n            FROM photo_items\n            WHERE deleted_at IS NULL AND binding_id = ANY($1)\n            ORDER BY binding_id, id DESC\n            ",
