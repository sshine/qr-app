{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, original_key, view_key, thumb_key, media_type, width, height,\n               byte_size, taken_at, caption, created_at, deleted_at\n        FROM photo_items\n        WHERE binding_id = $1\n          AND deleted_at IS NULL\n          AND ($2::uuid IS NULL OR id < $2)\n        ORDER BY id DESC\n        LIMIT $3\n        ",
