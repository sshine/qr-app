  "query": "\n        SELECT id, original_key, view_key, thumb_key, media_type, width, height,\n               byte_size, taken_at, caption, created_at, deleted_at\n        FROM photo_items\n        WHERE binding_id = $1 AND deleted_at IS NOT NULL\n        ORDER BY deleted_at DESC\n        ",
