  "query": "\n        SELECT t.id, t.name, t.created_at\n        FROM code_tags ct\n        JOIN tags t ON t.id = ct.tag_id\n        WHERE ct.code_id = $1\n        ORDER BY lower(t.name), t.created_at\n        ",
